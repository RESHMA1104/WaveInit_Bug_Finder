{
  "name": "waveinit_bug_finder",
  "version": "1.0.0",
  "description": "Real-time web automation testing framework for WaveInit using Playwright, Cucumber, and TypeScript.",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "search": "cucumber-js --tags @Search",
    "register": "cucumber-js --tags @Register",
    "rishwanth": "cucumber-js --tags @Rishwanth",
    "mycourse": "cucumber-js --tags @MyCourse",
    "prasanna": "cucumber-js --tags @Prasanna",
    "reshma": "cucumber-js --tags @Reshma",
    "haritha": "cucumber-js --tags @haritha",
    "parallel": "cucumber-js --parallel 2",
    "report": "ts-node src/helper/report.ts",
    "rerun": "cucumber-js --profile rerun",
    "test:report": "npm run test && npm run report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RESHMA1104/WaveInit_Bug_Finder.git"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "typescript",
    "automation-testing",
    "bdd",
    "web-automation",
    "functional-testing",
    "regression-testing",
    "real-time-testing",
    "team-project"
  ],
  "author": "WaveInit Automation Team",
  "license": "ISC",
  "engines": {
    "node": "22.23.2",
    "npm": ">=11"
  },
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.11.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "multiple-cucumber-html-reporter": "^3.8.0",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
